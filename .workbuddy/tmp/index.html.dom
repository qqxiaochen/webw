        <iframe src="https://www.youtube.com/embed/Mr6FaTdi9As" title="PaoMian Hax 展示影片" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen=""></iframe>
      </div>
      <div class="social-stack">
        <a class="social-card glass reveal" data-d="1" href="https://discord.com/invite/AtdYPSfvBP" target="_blank">
          <span class="social-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8.2 5.4h7.6a5 5 0 0 1 5 5v4.2a3.4 3.4 0 0 1-3.4 3.4h-1.4l-1.5-2h-4.5l-1.5 2H6.6a3.4 3.4 0 0 1-3.4-3.4v-4.2a5 5 0 0 1 5-5z"></path><circle cx="8.9" cy="12.4" r="1.1" fill="currentColor" stroke="none"></circle><circle cx="15.1" cy="12.4" r="1.1" fill="currentColor" stroke="none"></circle><path d="M8.6 15.6h6.8"></path></svg>
          </span>
          <span>
            <h4>Join our Discord</h4>
            <p>If you have any questions about hacktool, please join our dc/tg group.</p>
          </span>
          <svg class="social-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="social-card glass reveal" data-d="2" href="https://t.me/pmhax" target="_blank">
          <span class="social-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21.2 4.2L3.4 11.4l5.4 2.1M21.2 4.2l-4.6 14.6-5-6.3M21.2 4.2L8.8 13.5"></path></svg>
          </span>
          <span>
            <h4>交流群</h4>
            <p>如果你遇到了任何問題,請點擊加入我們的交流群。</p>
          </span>
          <svg class="social-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </section>
</main>

<!-- ================= Footer ================= -->
<footer class="footer">
  <div class="glass reveal">
    <p class="footer-text">(☆▽☆) <a href="https://www.smilegate.com/" target="_blank">SmileGate</a> &amp; PaoMianHax</p>
    <p class="footer-sub">PaoMian Hax is a team that since 2099 brings quality services in various areas.</p>
  </div>
</footer>

<!-- ================= macOS 玻璃弹窗（服務條款） ================= -->
<div class="modal" id="tosModal" role="dialog" aria-modal="true" aria-labelledby="tosTitle">
  <div class="modal-backdrop" data-close=""></div>
  <div class="modal-window">
    <div class="modal-bar">
      <span class="traffic" aria-hidden="true"><i></i><i></i><i></i></span>
      <h3 id="tosTitle">TERMS OF SERVICE</h3>
      <button class="modal-close" data-close="" type="button" aria-label="關閉">✕</button>
    </div>
    <div class="modal-body">
      <h4>服務條款</h4>
      <ol>
        <li>We may deactivate your license at any time without notice and reason.</li>
        <li>We are not responsible for any banishment/suspensions in the game.</li>
        <li>Some functions may not work correctly.</li>
        <li>You may not attempt to debug or reverse engineer our products.</li>
        <li>You may not share or resell our products.</li>
        <li>You can not attempt any type of attack against our site/server.</li>
        <li>You can only use the payment method for which you have permission.</li>
        <li>Disputing a payment will permanently disable your account.</li>
        <li>If you do not agree to terms, you are prohibited from our services.</li>
      </ol>
    </div>
  </div>
</div>

<!-- ================= 背景音樂開關 ================= -->
<button class="music-btn" id="musicBtn" type="button" aria-label="背景音樂開關">
  <svg class="ico-note" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18.2V6.4l10-2.1v11.8"></path><circle cx="6.6" cy="18.2" r="2.6"></circle><circle cx="16.6" cy="16.1" r="2.6"></circle></svg>
</button>

<script>
/* ============================================================
   交互層：導覽 / 移動選單 / 滾動漸入 / 玻璃弹窗 / 音樂 / Hero 視差
   ============================================================ */
(function(){
  'use strict';

  /* ---------- 1. 導航滾動態：玻璃 pill 收縮 ---------- */
  var nav = document.getElementById('nav');
  var ticking = false;
  function onScrollNav(){
    if(!ticking){
      window.requestAnimationFrame(function(){
        nav.classList.toggle('scrolled', window.scrollY > 24);
        ticking = false;
      });
      ticking = true;
    }
  }
  window.addEventListener('scroll', onScrollNav, {passive:true});
  onScrollNav();

  /* ---------- 2. Hero 滾動漸變：內容淡出 + 上移 ---------- */
  var heroInner = document.getElementById('heroInner');
  function onScrollHero(){
    if(!ticking){
      window.requestAnimationFrame(function(){
        var t = Math.min(window.scrollY, 620);
        if(t > 0){
          heroInner.style.opacity = Math.max(0, 1 - t / 520);
          heroInner.style.transform = 'translateY(' + (t * 0.14).toFixed(1) + 'px)';
        }else{
          heroInner.style.opacity = '1';
          heroInner.style.transform = 'none';
        }
        ticking = false;
      });
      ticking = true;
    }
  }
  window.addEventListener('scroll', onScrollHero, {passive:true});

  /* ---------- 3. 移動端玻璃選單 ---------- */
  var burger = document.getElementById('navBurger');
  var menu = document.getElementById('navMenu');
  burger.addEventListener('click', function(){
    var open = menu.classList.toggle('open');
    burger.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  menu.addEventListener('click', function(e){
    if(e.target.closest('a')){  /* 點擊鏈接後收起選單 */
      menu.classList.remove('open');
      burger.classList.remove('open');
      burger.setAttribute('aria-expanded','false');
    }
  });

  /* ---------- 4. 滾動漸入（IntersectionObserver） ---------- */
  var revealEls = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      });
    }, {threshold: .12, rootMargin: '0px 0px -40px 0px'});
    revealEls.forEach(function(el){ io.observe(el); });
  }else{
    revealEls.forEach(function(el){ el.classList.add('in'); });
  }

  /* ---------- 5. macOS 玻璃弹窗（服務條款） ---------- */
  var modal = document.getElementById('tosModal');
  var tosOpen = document.getElementById('tosOpen');
  function openModal(){ modal.classList.add('open'); document.body.style.overflow = 'hidden'; }
  function closeModal(){ modal.classList.remove('open'); document.body.style.overflow = ''; }
  tosOpen.addEventListener('click', openModal);
  modal.addEventListener('click', function(e){
    if(e.target.hasAttribute('data-close')) closeModal();
  });
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && modal.classList.contains('open')) closeModal();
  });

  /* ---------- 6. 背景音樂開關（懶加載，默認關閉） ---------- */
  var musicBtn = document.getElementById('musicBtn');
  var audio = null;
  var playing = false;
  musicBtn.addEventListener('click', function(){
    if(!audio){
      audio = new Audio('static/music.mp3');
      audio.loop = true;
      audio.preload = 'none';
    }
    if(playing){
      audio.pause();
      playing = false;
      musicBtn.classList.remove('playing');
      musicBtn.setAttribute('aria-label','播放背景音樂');
    }else{
      var p = audio.play();
      if(p && p.catch) p.catch(function(){ /* 瀏覽器阻止時忽略，下次點擊重試 */ });
      playing = true;
      musicBtn.classList.add('playing');
      musicBtn.setAttribute('aria-label','暫停背景音樂');
    }
  });
})();
</script>


</body></html>
